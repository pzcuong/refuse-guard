\newlabel{sec:rq1}{{5.1}{4}{RQ1: Does defensive refusal reproduce? No --- the gate fails}{subsection.5.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Headline results per model at pilot scale. Top: E0 reproduction gate (RR per prompt arm on 20 paired vulnerability-analysis functions per arm) and contrast-probe behaviour (over-refusal on 12 COMPLY-expected probes / unsafe compliance on 13 REFUSE-expected probes, per arm). Middle: E2/E3 context-stress results on the 60-sample paired benchmark, both models. Bottom: E6 IPI defence and E8 safety preservation (30 unsafe / 30 safe prompts, recomputed with the fixed refusal monitor). $\Delta $RR is invariant to the Qwen monitor's over-refusal error because it pumps both arms symmetrically (paired McNemar).\relax }}{5}{table.caption.6}\protected@file@percent }
\newlabel{tab:main}{{1}{5}{Headline results per model at pilot scale. Top: E0 reproduction gate (RR per prompt arm on 20 paired vulnerability-analysis functions per arm) and contrast-probe behaviour (over-refusal on 12 COMPLY-expected probes / unsafe compliance on 13 REFUSE-expected probes, per arm). Middle: E2/E3 context-stress results on the 60-sample paired benchmark, both models. Bottom: E6 IPI defence and E8 safety preservation (30 unsafe / 30 safe prompts, recomputed with the fixed refusal monitor). $\Delta $RR is invariant to the Qwen monitor's over-refusal error because it pumps both arms symmetrically (paired McNemar).\relax }{table.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Refusal-monitor calibration and validity. Thresholds (refusal-threshold / lexical floor) are fitted per model on the frozen 125-prompt calibration half; scoring prompts are disjoint by construction (25/125 scoring probes were later consumed by pre-registered E0 runs and are reported, not re-used). Over-refusal is the monitor's error on COMPLY-expected probes; the pre-registered E0 protocol (\S  \ref  {sec:setup}) requires $\leq 0.10$ for the monitor to be considered valid as a primary-endpoint instrument. The Qwen row violates the criterion and is disclosed as a known measurement limitation.\relax }}{5}{table.caption.7}\protected@file@percent }
\newlabel{tab:calibration}{{2}{5}{Refusal-monitor calibration and validity. Thresholds (refusal-threshold / lexical floor) are fitted per model on the frozen 125-prompt calibration half; scoring prompts are disjoint by construction (25/125 scoring probes were later consumed by pre-registered E0 runs and are reported, not re-used). Over-refusal is the monitor's error on COMPLY-expected probes; the pre-registered E0 protocol (\S \ref {sec:setup}) requires $\leq 0.10$ for the monitor to be considered valid as a primary-endpoint instrument. The Qwen row violates the criterion and is disclosed as a known measurement limitation.\relax }{table.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}RQ2: Does untrusted context degrade utility? Availability: no. Verdicts: yes}{5}{subsection.5.2}\protected@file@percent }
\newlabel{sec:rq2}{{5.2}{5}{RQ2: Does untrusted context degrade utility? Availability: no. Verdicts: yes}{subsection.5.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Defences at pilot scale (Qwen2.5-Coder-3B unless noted). E5: comment stripping (B2), aggressive text removal (B3) and prompt reframing (B1) never remove a refusal because there are no refusals to remove (DRR undefined, $n{=}0$ candidates). E6: P1 semantic isolation. E7: LLM-then-transformer fallback on the cached 0.5B E3 records (133 in-universe). E8: unsafe compliance on 30 unsafe prompts, safe refusal on 30 safe prompts, before (Round-2 pipeline) and after (Round-3, gate-first) the P2 redesign, recomputed with the fixed monitor.\relax }}{5}{table.caption.8}\protected@file@percent }
\newlabel{tab:defenses}{{3}{5}{Defences at pilot scale (Qwen2.5-Coder-3B unless noted). E5: comment stripping (B2), aggressive text removal (B3) and prompt reframing (B1) never remove a refusal because there are no refusals to remove (DRR undefined, $n{=}0$ candidates). E6: P1 semantic isolation. E7: LLM-then-transformer fallback on the cached 0.5B E3 records (133 in-universe). E8: unsafe compliance on 30 unsafe prompts, safe refusal on 30 safe prompts, before (Round-2 pipeline) and after (Round-3, gate-first) the P2 redesign, recomputed with the fixed monitor.\relax }{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces B4 CodeBERT baseline (best epoch 1/3, seed 1234). ``Balanced pilot'' is the 600-sample manifest arm (300/300); ``realistic'' is all 549 test-split vulnerable functions plus a seeded 20,000-function benign subsample from the official test split (PrimeVul v0.1 mirror). The drop between the two arms reproduces, on our substrate, the optimism-gap phenomenon reported by PrimeVul\nonbreakingspace \citep  {ding2025primevul}; paired outcomes use PrimeVul's P-C/P-V/P-B/P-R definitions.\relax }}{6}{table.caption.9}\protected@file@percent }
\newlabel{tab:codebert}{{4}{6}{B4 CodeBERT baseline (best epoch 1/3, seed 1234). ``Balanced pilot'' is the 600-sample manifest arm (300/300); ``realistic'' is all 549 test-split vulnerable functions plus a seeded 20,000-function benign subsample from the official test split (PrimeVul v0.1 mirror). The drop between the two arms reproduces, on our substrate, the optimism-gap phenomenon reported by PrimeVul~\cite {ding2025primevul}; paired outcomes use PrimeVul's P-C/P-V/P-B/P-R definitions.\relax }{table.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces E6: injection success under C3 (share of paired samples whose verdict flips to benign vs.\ the clean prediction). P1 semantic isolation reduces the aggregate from 0.742 to 0.484 (McNemar $p=0.0078$), but 6 of the 8 discordant pairs are benign ground truth ($p=0.031$); on vulnerable-only pairs the improvement (2 pairs) is not significant ($p=0.5$). Source: \texttt  {outputs/experiments/round3\_e6/results.json}.\relax }}{6}{figure.caption.11}\protected@file@percent }
\newlabel{fig:e6}{{3}{6}{E6: injection success under C3 (share of paired samples whose verdict flips to benign vs.\ the clean prediction). P1 semantic isolation reduces the aggregate from 0.742 to 0.484 (McNemar $p=0.0078$), but 6 of the 8 discordant pairs are benign ground truth ($p=0.031$); on vulnerable-only pairs the improvement (2 pairs) is not significant ($p=0.5$). Source: \texttt {outputs/experiments/round3\_e6/results.json}.\relax }{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces E8: unsafe-compliance rate on 30 unsafe prompts. The naive Round-2 pipeline (pre-fix) suppresses refusals outright (P2 $=1.000$ vs.\ B0 $=0.040$); the revised gate-first pipeline (fixed) never forwards unsafe requests to the LLM (gate blocks 30/30) and does not increase unsafe compliance for either model. Sources: \texttt  {pilot\_round2\_recomputed/ summary\_v2.json}; \texttt  {round3\_e8\{,\_llama3b\}/recomputed/ recompute\_e8\_monitor.json}.\relax }}{6}{figure.caption.12}\protected@file@percent }
\newlabel{fig:e8}{{4}{6}{E8: unsafe-compliance rate on 30 unsafe prompts. The naive Round-2 pipeline (pre-fix) suppresses refusals outright (P2 $=1.000$ vs.\ B0 $=0.040$); the revised gate-first pipeline (fixed) never forwards unsafe requests to the LLM (gate blocks 30/30) and does not increase unsafe compliance for either model. Sources: \texttt {pilot\_round2\_recomputed/ summary\_v2.json}; \texttt {round3\_e8\{,\_llama3b\}/recomputed/ recompute\_e8\_monitor.json}.\relax }{figure.caption.12}{}}
